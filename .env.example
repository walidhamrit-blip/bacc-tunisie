# Connexion Neon (Project > Dashboard > Connect > "Pooled connection")
# ⚠️ Utilise bien l'URL *pooled* (-pooler dans le host) pour Vercel/serverless.
DATABASE_URL="postgresql://user:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Optionnel : nombre max de connexions par instance serverless (défaut 3)
# PG_POOL_MAX=3

# Optionnel : enrichissement IA du corrigé (sinon le guide pédagogique local suffit)
# OPENAI_API_KEY=""
